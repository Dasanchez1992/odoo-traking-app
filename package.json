{
  "name": "elipsys-time",
  "version": "1.12.1",
  "description": "Elipsys Time: app de escritorio para ver tareas asignadas en Odoo, registrar tiempo trabajado, fichar entrada/salida y recibir avisos de tareas caducadas",
  "main": "electron/main.js",
  "author": "Danilo Sanchez",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env ELECTRON_START_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "check:ipc": "node scripts/check-ipc.js",
    "dist:deb": "npm run build && electron-builder --linux deb"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.0.2",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.3",
    "vite": "^5.3.1",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "electron-updater": "^6.8.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@huggingface/transformers": "^4.3.1"
  },
  "build": {
    "appId": "com.elipsys.elideysi",
    "productName": "Elipsys Time",
    "artifactName": "ElipsysTime-${version}-setup.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json",
      "!node_modules/sharp/**",
      "!node_modules/@img/**",
      "!node_modules/onnxruntime-web/dist/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Dasanchez1992",
        "repo": "odoo-traking-app-release",
        "private": false,
        "releaseType": "release"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v6/linux/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Elipsys Time"
    },
    "linux": {
      "target": [
        "deb"
      ],
      "icon": "build/icons",
      "category": "Office",
      "maintainer": "Elipsys <danilo.sanchez@elipsys.ec>",
      "synopsis": "Tareas, cronómetro y fichaje sobre Odoo",
      "description": "Elipsys Time: ver las tareas asignadas en Odoo, registrar el tiempo trabajado, fichar entrada y salida, grabar y resumir reuniones y recibir avisos de tareas caducadas.",
      "artifactName": "ElipsysTime-${version}-${arch}.${ext}",
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/linux/arm64/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/linux/x64/libonnxruntime_providers_cuda.so",
        "!node_modules/onnxruntime-node/bin/napi-v6/linux/x64/libonnxruntime_providers_tensorrt.so"
      ]
    },
    "asarUnpack": [
      "node_modules/@huggingface/transformers/**",
      "node_modules/onnxruntime-node/**"
    ]
  }
}
